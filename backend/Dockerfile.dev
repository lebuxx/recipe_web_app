# Dev variant: starts with --reload, code is mounted via a volume instead of copied
FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN mkdir -p /app/data

EXPOSE 81

CMD ["fastapi", "dev", "main.py", "--host", "0.0.0.0", "--port", "81"]
